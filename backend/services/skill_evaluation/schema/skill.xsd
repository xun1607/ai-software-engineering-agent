<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="skill">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="metadata">
          <xs:complexType>
            <xs:sequence>
              <!-- Core Fields (Required by System) -->
              <xs:element name="name" type="xs:string"/>
              <xs:element name="description" type="xs:string"/>
              
              <!-- Optional/Extra Fields (Ordered by common generation) -->
              <xs:element name="goal" type="xs:string" minOccurs="0"/>
              <xs:element name="version" type="xs:string"/>
              <xs:element name="category">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:minLength value="1"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="level">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="atomic"/>
                    <xs:enumeration value="composite"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>

              <!-- Extended Metadata Fields (Optional) -->
              <xs:element name="tags" type="xs:string" minOccurs="0"/>
              <xs:element name="sub_skills" type="xs:string" minOccurs="0"/>
              <xs:element name="input" type="xs:string" minOccurs="0"/>
              <xs:element name="output" type="xs:string" minOccurs="0"/>
              <xs:element name="constraints" type="xs:string" minOccurs="0"/>
              <xs:element name="acceptance_criteria" type="xs:string" minOccurs="0"/>
              <xs:element name="metrics" type="xs:string" minOccurs="0"/>
              <xs:element name="test_cases" type="xs:string" minOccurs="0"/>
              
              <!-- Catch-all for any other YAML frontmatter fields -->
              <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="instruction" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
